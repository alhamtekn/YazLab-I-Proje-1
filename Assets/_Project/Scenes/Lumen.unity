  m_Script: {fileID: 11500000, guid: 21184d67c8134cebb7cdc95cf8b74526, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Lumen.Runtime::Lumen.Level.LoreInscription
  title: "Duvardaki F\u0131s\u0131lt\u0131"
  text: "Arven'i tehditle ya da hileyle kimse ge\xE7emedi. Ona kristallerin \u0131\u015F\u0131\u011F\u0131n\u0131 getirdi\u011Fini s\xF6yle, ilk \u0131\u015F\u0131\u011F\u0131n ad\u0131n\u0131 an. Ta\u015F bile hat\u0131rlad\u0131\u011F\u0131 \u015Feye kulak verir."
  journal: {fileID: 644610605}
  glyphLight: {fileID: 1284159985}
  readColor: {r: 0.55, g: 0.6, b: 0.7, a: 1}
